# Copy to .env and fill in. docker-compose reads this file automatically.

SESSION_SECRET=generate-with-node-crypto-randombytes
# The URL users hit in their browser (through your reverse proxy)
BASE_URL=https://control.example.com
# 1 when behind an HTTPS reverse proxy, 0 for plain http
COOKIE_SECURE=1

# SMTP — configure your mail server/provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=control@example.com
SMTP_PASS=your-password
SMTP_FROM=Control <control@example.com>

# Timezone for container logs (deadlines use each user's own profile timezone)
TZ=UTC